From b38237da630973c64cd9fc7dad90599ba6fc724f Mon Sep 17 00:00:00 2001
From: Jeongkyu Shin <jshin@lablup.com>
Date: Wed, 30 Sep 2026 15:50:29 +0900
Subject: [PATCH] fix(rocm): fix Scatter's size argument and widen narrow index
 dtypes

Scatter::eval_gpu passed upd_post_idx_size as int32_t while scatter_general_kernel declares it int64_t. add_kernel_node hands HIP the address of each argument, so the kernel read eight bytes from a four-byte value, got a huge divisor and computed index element 0 for every update: x[idx] = v, x.at[idx].add(v) and everything built on scatter (eye, identity, tri, diag) applied a single update. The argument is now int64_t, and add_kernel_node statically asserts that every argument has the size of its kernel parameter, so this class of mismatch fails to compile.

Five dispatch sites in indexing.hip chose the kernel's index type with int32_t for int32/uint32 and int64_t for everything else, so int8, uint8, int16, uint16 and bool index arrays reached a kernel that reads eight bytes per element from a one or two byte buffer. On ROCm that is an HSA_STATUS_ERROR_MEMORY_APERTURE_VIOLATION; the queue aborts and the process spins. Narrow index arrays are now widened to int32 once before the dispatch. Instantiating the kernels for all eight integer dtypes is also correct but took this translation unit from 26 s to 348 s to compile, because the index type multiplies the existing product of value dtypes and index-count branches; CUDA and Metal avoid that cost by compiling these kernels at runtime.
---
 mlx/backend/rocm/device.h     |  28 ++++++++
 mlx/backend/rocm/indexing.hip | 122 +++++++++++++++++++++++++++++-----
 2 files changed, 134 insertions(+), 16 deletions(-)

diff --git a/mlx/backend/rocm/device.h b/mlx/backend/rocm/device.h
index fad1f176..0943a691 100644
--- a/mlx/backend/rocm/device.h
+++ b/mlx/backend/rocm/device.h
@@ -45,6 +45,25 @@ extern std::atomic<long> g_inline_launches_;
 void set_current_prim(const char* name);
 void record_inline_launch();
 
+// add_kernel_node hands HIP the address of every argument, so
+// each argument must have the same size as the kernel parameter it lands in.
+// A narrower argument is read with garbage high bytes (Scatter once passed an
+// int32_t for an int64_t parameter and every update collapsed onto the first
+// index), so the sizes are checked at compile time.
+template <typename Func>
+struct kernel_param_types;
+template <typename... Args>
+struct kernel_param_types<void(Args...)> {
+  using type = std::tuple<Args...>;
+};
+template <typename KernelArgs, typename Passed, std::size_t... I>
+constexpr bool kernel_arg_sizes_match(std::index_sequence<I...>) {
+  return (
+      (sizeof(std::tuple_element_t<I, KernelArgs>) ==
+       sizeof(std::decay_t<std::tuple_element_t<I, Passed>>)) &&
+      ...);
+}
+
 class CommandEncoder {
  public:
   explicit CommandEncoder(Device& d);
@@ -77,6 +96,15 @@ class CommandEncoder {
       uint32_t smem_bytes,
       Params&&... params) {
     constexpr size_t num = sizeof...(Params);
+    using KernelArgs = typename kernel_param_types<Func>::type;
+    static_assert(
+        std::tuple_size_v<KernelArgs> == num,
+        "add_kernel_node: argument count differs from the kernel's parameters");
+    static_assert(
+        kernel_arg_sizes_match<KernelArgs, std::tuple<Params...>>(
+            std::index_sequence_for<Params...>{}),
+        "add_kernel_node: an argument's size differs from its kernel "
+        "parameter; pass the parameter's exact type");
     if (!use_hip_graphs()) {
       // Immediate launch: kernelParams are consumed synchronously, so
       // addresses of the caller's locals are fine.
diff --git a/mlx/backend/rocm/indexing.hip b/mlx/backend/rocm/indexing.hip
index d117d439..6bdbcaed 100644
--- a/mlx/backend/rocm/indexing.hip
+++ b/mlx/backend/rocm/indexing.hip
@@ -22,6 +22,43 @@
 
 namespace mlx::core {
 
+namespace {
+
+// Widen a narrow index array to int32.
+//
+// The dispatch sites below pick the kernel's index type with a two-way branch,
+// int32_t for int32 and uint32 and int64_t for everything else. That sent
+// int8, uint8, int16, uint16 and bool index arrays to a kernel that reads
+// eight bytes per element out of a one or two byte buffer, which on ROCm is an
+// HSA_STATUS_ERROR_MEMORY_APERTURE_VIOLATION: the GPU queue aborts and the
+// process spins. MLX accepts any integer dtype for indices, so a `take` with a
+// uint8 index array (a 4-bit codebook lookup, for example) reaches it.
+//
+// Widening once here rather than instantiating every kernel for every integer
+// dtype is a deliberate trade. Measured on this backend, giving each of the
+// eight integer dtypes its own instantiation took the compile time of this
+// translation unit from 26 s to 348 s, because the index type multiplies an
+// existing product of twelve value dtypes and five to six index-count
+// branches. Widening keeps the two instantiations and costs one copy pass over
+// the index array, and only on the paths that are broken today.
+bool index_dtype_needs_widening(Dtype dt) {
+  return dt == int8 || dt == uint8 || dt == int16 || dt == uint16 ||
+      dt == bool_;
+}
+
+array widen_index_to_int32(
+    const array& idx,
+    rocm::CommandEncoder& encoder,
+    const Stream& s) {
+  array wide(idx.shape(), int32, nullptr, {});
+  copy_gpu(idx, wide, CopyType::General, s);
+  encoder.add_temporary(wide);
+  return wide;
+}
+
+} // namespace
+
+
 namespace rocm {
 
 // General gather kernel - handles arbitrary indexing
@@ -605,6 +642,22 @@ void Gather::eval_gpu(const std::vector<array>& inputs, array& out) {
   int nidx = inputs.size() - 1;
   int32_t idx_ndim = nidx > 0 ? inputs[1].ndim() : 0;
 
+  // Widen narrow index dtypes once, so the
+  // two-way index-type dispatch below cannot read a one or two byte buffer as
+  // int64_t. Reserved so the references handed out below stay valid.
+  std::vector<array> widened_idx;
+  widened_idx.reserve(nidx);
+  std::vector<const array*> idx_arrays(std::max(nidx, 1), nullptr);
+  for (int i = 0; i < nidx; ++i) {
+    const array& given = inputs[i + 1];
+    if (index_dtype_needs_widening(given.dtype())) {
+      widened_idx.push_back(widen_index_to_int32(given, encoder, s));
+      idx_arrays[i] = &widened_idx.back();
+    } else {
+      idx_arrays[i] = &given;
+    }
+  }
+
   uint32_t slice_size = std::accumulate(
       slice_sizes_.begin(), slice_sizes_.end(), 1, std::multiplies<uint32_t>());
 
@@ -620,16 +673,20 @@ void Gather::eval_gpu(const std::vector<array>& inputs, array& out) {
   std::vector<int64_t> h_indices_strides(std::max(nidx, 1) * std::max(idx_ndim, 1));
 
   for (int i = 0; i < nidx; ++i) {
-    h_indices[i] = gpu_ptr<void>(inputs[i + 1]);
+    const array& idx_in = *idx_arrays[i];
+    h_indices[i] = gpu_ptr<void>(idx_in);
     for (int j = 0; j < idx_ndim; ++j) {
-      h_indices_shape[i * idx_ndim + j] = inputs[i + 1].shape(j);
-      h_indices_strides[i * idx_ndim + j] = inputs[i + 1].strides(j);
+      h_indices_shape[i * idx_ndim + j] = idx_in.shape(j);
+      h_indices_strides[i * idx_ndim + j] = idx_in.strides(j);
     }
   }
 
   for (const auto& in : inputs) {
     encoder.set_input_array(in);
   }
+  for (const auto& widened : widened_idx) {
+    encoder.set_input_array(widened);
+  }
   encoder.set_output_array(out);
 
   int64_t total = out.size();
@@ -640,7 +697,7 @@ void Gather::eval_gpu(const std::vector<array>& inputs, array& out) {
   // contiguous (flattened) index -> coalesced per-row copy (gather_rows_kernel).
   bool fast_rows = (nidx == 1) && (axes_.size() == 1) && (axes_[0] == 0) &&
       src.ndim() >= 2 && src.flags().row_contiguous &&
-      inputs[1].flags().contiguous &&
+      idx_arrays[0]->flags().contiguous &&
       ((int)slice_sizes_.size() == (int)src.ndim()) && (slice_sizes_[0] == 1);
   if (fast_rows) {
     for (int d = 1; d < (int)src.ndim(); ++d) {
@@ -668,7 +725,7 @@ void Gather::eval_gpu(const std::vector<array>& inputs, array& out) {
       int64_t n_rows = total / (int64_t)slice_size;
       dim3 grid((unsigned int)n_rows);
       dim3 blk(256);
-      Dtype it = inputs[1].dtype();
+      Dtype it = idx_arrays[0]->dtype();
       int32_t src_dim0 = (int32_t)src.shape(0);
       #define LAUNCH_ROWS(T, IdxT) \
         encoder.add_kernel_node((&rocm::gather_rows_kernel<T, IdxT>), grid, blk, 0, \
@@ -725,7 +782,7 @@ void Gather::eval_gpu(const std::vector<array>& inputs, array& out) {
         default: LAUNCH_GATHER(T, IdxT, 8); break; \
       }
 
-    Dtype idx_dtype = nidx > 0 ? inputs[1].dtype() : int32;
+    Dtype idx_dtype = nidx > 0 ? idx_arrays[0]->dtype() : int32;
     
     if (idx_dtype == int32 || idx_dtype == uint32) {
       switch (out.dtype()) {
@@ -793,11 +850,31 @@ void Scatter::eval_gpu(const std::vector<array>& inputs, array& out) {
   int nidx = axes_.size();
   int32_t idx_ndim = nidx > 0 ? inputs[1].ndim() : 0;
 
-  int32_t upd_post_idx_size = std::accumulate(
+  // Widen narrow index dtypes once, so the
+  // two-way index-type dispatch below cannot read a one or two byte buffer as
+  // int64_t. Reserved so the references handed out below stay valid.
+  std::vector<array> widened_idx;
+  widened_idx.reserve(nidx);
+  std::vector<const array*> idx_arrays(std::max(nidx, 1), nullptr);
+  for (int i = 0; i < nidx; ++i) {
+    const array& given = inputs[i + 1];
+    if (index_dtype_needs_widening(given.dtype())) {
+      widened_idx.push_back(widen_index_to_int32(given, encoder, s));
+      idx_arrays[i] = &widened_idx.back();
+    } else {
+      idx_arrays[i] = &given;
+    }
+  }
+
+  // int64_t to match scatter_general_kernel's parameter.
+  // add_kernel_node passes argument addresses straight to HIP, so an int32_t
