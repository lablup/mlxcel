 mlx/backend/rocm/quantized/qmm.hip | 129 ++++++++++++++++++++++++-----
 1 file changed, 108 insertions(+), 21 deletions(-)

diff --git a/mlx/backend/rocm/quantized/qmm.hip b/mlx/backend/rocm/quantized/qmm.hip
index a725ee7a..e10fc534 100644
