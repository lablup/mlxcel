+++ b/mlx/backend/rocm/quantized/qmm.hip
@@ -3835,9 +3835,15 @@ void QuantizedMatmul::eval_gpu(const std::vector<array>& inputs, array& out) {
   // Restrict to 4/8-bit; 2/5/6-bit fall through to the warp-shared QMV kernel.
   bool tiled_bits_supported = (bits_ == 4 || bits_ == 8);
   // tile_n can be 4 on low-CU gfx1152 — still a valid tiled path.
+  // The launches below cover only bf16/f16 and group sizes
+  // 32/64/128, but the branch returns unconditionally, so any other input
+  // (f32 activations in particular) left the output unwritten and returned
+  // whatever the allocation held. Only enter when a kernel will launch.
   if (use_tiled && tiled_bits_supported && use_fast_qmv &&
       !can_use_batched_qmv && tile_n >= 4 &&
-      mode_ == QuantizationMode::Affine) {
+      mode_ == QuantizationMode::Affine &&
+      (x.dtype() == bfloat16 || x.dtype() == float16) &&
+      (group_size_ == 32 || group_size_ == 64 || group_size_ == 128)) {
     {
       dim3 tiled_block(host_warp, tile_n);
       const int n_tiles = (N + tile_n - 1) / tile_n;
@@ -4264,8 +4270,11 @@ void QuantizedMatmul::eval_gpu(const std::vector<array>& inputs, array& out) {
     using gs64 = std::integral_constant<int, 64>;
     using gs128 = std::integral_constant<int, 128>;
 
+    // mxfp4/mxfp8 store one E8M0 byte per group, not a T-typed scale.
+    using u8_id = local_type_identity<uint8_t>;
+
 // Helper macro to dispatch group_size
-#define DISPATCH_GROUP_SIZE(type_tag, scale_tag, bits_tag)   \
+#define DISPATCH_GROUP_SIZE_IMPL(type_tag, scale_tag, bits_tag)   \
   do {                                                       \
     switch (group_size_) {                                   \
       case 32:                                               \
@@ -4283,6 +4292,14 @@ void QuantizedMatmul::eval_gpu(const std::vector<array>& inputs, array& out) {
             std::to_string(group_size_));                    \
     }                                                        \
   } while (0)
+#define DISPATCH_GROUP_SIZE(type_tag, scale_tag, bits_tag)            \
+  do {                                                                \
+    if (mode_ == QuantizationMode::Affine) {                          \
+      DISPATCH_GROUP_SIZE_IMPL(type_tag, scale_tag, bits_tag);        \
+    } else {                                                          \
+      DISPATCH_GROUP_SIZE_IMPL(type_tag, u8_id{}, bits_tag);          \
+    }                                                                 \
+  } while (0)
 
     if (x.dtype() == float32) {
       if (bits_ == 8)
@@ -4334,6 +4351,7 @@ void QuantizedMatmul::eval_gpu(const std::vector<array>& inputs, array& out) {
     }
 
 #undef DISPATCH_GROUP_SIZE
+#undef DISPATCH_GROUP_SIZE_IMPL
   }
 }
 
@@ -6242,16 +6260,20 @@ void GatherQMM::eval_gpu(const std::vector<array>& inputs, array& out) {
       return;
     }
 
+    // f16 takes the same warp-shared kernel as bf16. It was gated
+    // to bf16 only, so f16 checkpoints fell through to
+    // the generic gather_qmv_kernel at about 200 ms per call.
     if (use_fast_gather_qmv && mode_ == QuantizationMode::Affine &&
-        x.dtype() == bfloat16 && group_size_ == 64 &&
+        (x.dtype() == bfloat16 || x.dtype() == float16) && group_size_ == 64 &&
         (bits_ == 4 || bits_ == 6 || bits_ == 8)) {
-      auto launch_fast_kernel = [&](auto bits_tag) {
+      auto launch_fast_kernel = [&](auto type_tag, auto bits_tag) {
+        using T = typename decltype(type_tag)::type;
         constexpr int BITS = decltype(bits_tag)::value;
         if (fast_threads_per_col == 16) {
           enc.add_kernel_node(
               &rocm::gather_qmv_warp_shared_kernel<
-                  hip_bfloat16,
-                  hip_bfloat16,
+                  T,
+                  T,
                   BITS,
                   64,
                   true,
@@ -6259,17 +6281,17 @@ void GatherQMM::eval_gpu(const std::vector<array>& inputs, array& out) {
               fast_grid,
               fast_block,
               0u,
-              (const hip_bfloat16*)x_ptr,
+              (const T*)x_ptr,
               (const uint8_t*)w_ptr,
-              (const hip_bfloat16*)scales_ptr,
-              (const hip_bfloat16*)biases_ptr,
+              (const T*)scales_ptr,
+              (const T*)biases_ptr,
               li_ptr,
               ri_ptr,
               batch_shape_param,
               lhs_idx_strides_param,
               rhs_idx_strides_param,
               batch_ndim,
-              (hip_bfloat16*)out_ptr,
+              (T*)out_ptr,
               B,
               M,
               N,
@@ -6281,8 +6303,8 @@ void GatherQMM::eval_gpu(const std::vector<array>& inputs, array& out) {
         } else {
           enc.add_kernel_node(
               &rocm::gather_qmv_warp_shared_kernel<
-                  hip_bfloat16,
-                  hip_bfloat16,
+                  T,
+                  T,
                   BITS,
                   64,
                   true,
@@ -6290,17 +6312,17 @@ void GatherQMM::eval_gpu(const std::vector<array>& inputs, array& out) {
               fast_grid,
               fast_block,
               0u,
-              (const hip_bfloat16*)x_ptr,
+              (const T*)x_ptr,
               (const uint8_t*)w_ptr,
-              (const hip_bfloat16*)scales_ptr,
-              (const hip_bfloat16*)biases_ptr,
+              (const T*)scales_ptr,
+              (const T*)biases_ptr,
               li_ptr,
               ri_ptr,
               batch_shape_param,
               lhs_idx_strides_param,
               rhs_idx_strides_param,
               batch_ndim,
-              (hip_bfloat16*)out_ptr,
+              (T*)out_ptr,
               B,
               M,
               N,
@@ -6312,18 +6334,83 @@ void GatherQMM::eval_gpu(const std::vector<array>& inputs, array& out) {
         }
       };
 
-      if (bits_ == 4) {
-        launch_fast_kernel(std::integral_constant<int, 4>{});
-      } else if (bits_ == 6) {
-        launch_fast_kernel(std::integral_constant<int, 6>{});
+      auto launch_fast_bits = [&](auto type_tag) {
+        if (bits_ == 4) {
+          launch_fast_kernel(type_tag, std::integral_constant<int, 4>{});
+        } else if (bits_ == 6) {
+          launch_fast_kernel(type_tag, std::integral_constant<int, 6>{});
+        } else {
+          launch_fast_kernel(type_tag, std::integral_constant<int, 8>{});
+        }
+      };
+      if (x.dtype() == float16) {
+        launch_fast_bits(local_type_identity<__half>{});
       } else {
-        launch_fast_kernel(std::integral_constant<int, 8>{});
+        launch_fast_bits(local_type_identity<hip_bfloat16>{});
       }
       return;
     }
 
 #define has_bias has_bias, use_sorted_rhs_schedule, implicit_x_batch_stride
 
+    // mxfp4/mxfp8 store one E8M0 byte per group and no biases,
+    // but every launch below instantiates the kernel with AFFINE=true and a
+    // T-typed scale pointer, which dequantizes fp weights with the affine
+    // formula. Route non-affine modes to the AFFINE=false instantiation with
+    // uint8_t scales instead.
+    if (mode_ != QuantizationMode::Affine) {
+      if (group_size_ != 32 || (bits_ != 4 && bits_ != 8)) {
+        throw std::runtime_error(
+            "[GatherQMM::eval_gpu] ROCm supports mxfp4/mxfp8 only (group_size "
+            "32, bits 4 or 8); got bits=" +
+            std::to_string(bits_) + " group_size=" + std::to_string(group_size_));
+      }
+      auto launch_fp = [&](auto type_tag, auto bits_tag) {
+        using T = typename decltype(type_tag)::type;
+        constexpr int BITS = decltype(bits_tag)::value;
+        enc.add_kernel_node(
+            &rocm::gather_qmv_kernel<T, uint8_t, BITS, 32, false>,
+            grid,
+            dim3(block_size),
+            0u,
+            (const T*)x_ptr,
+            (const uint8_t*)w_ptr,
+            (const uint8_t*)scales_ptr,
+            (const uint8_t*)biases_ptr,
+            li_ptr,
+            ri_ptr,
+            batch_shape_param,
+            lhs_idx_strides_param,
+            rhs_idx_strides_param,
+            batch_ndim,
+            (T*)out_ptr,
+            B,
+            M,
+            N,
+            K,
+            E,
+            has_bias);
+      };
+      auto launch_fp_bits = [&](auto type_tag) {
+        if (bits_ == 8) {
+          launch_fp(type_tag, std::integral_constant<int, 8>{});
+        } else {
+          launch_fp(type_tag, std::integral_constant<int, 4>{});
+        }
+      };
+      if (x.dtype() == float32) {
+        launch_fp_bits(local_type_identity<float>{});
+      } else if (x.dtype() == float16) {
+        launch_fp_bits(local_type_identity<__half>{});
+      } else if (x.dtype() == bfloat16) {
+        launch_fp_bits(local_type_identity<hip_bfloat16>{});
+      } else {
+        throw std::runtime_error(
+            "[GatherQMM::eval_gpu] unsupported activation dtype for mxfp");
+      }
+      return;
+    }
+
     if (x.dtype() == float32) {
       if (bits_ == 8 && group_size_ == 32) {
         enc.add_kernel_node(
