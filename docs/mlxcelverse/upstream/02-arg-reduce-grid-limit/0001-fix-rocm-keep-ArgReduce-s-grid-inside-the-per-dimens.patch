From 5c4c2f9a9d9788c7e322e34fb7b713125360df4a Mon Sep 17 00:00:00 2001
From: Jeongkyu Shin <jshin@lablup.com>
Date: Wed, 30 Sep 2026 15:50:29 +0900
Subject: [PATCH] fix(rocm): keep ArgReduce's grid inside the per-dimension
 limit

For short reduction axes ArgReduce::eval_gpu launched one 1024-thread block per output over a 1-D grid. AMD limits each grid dimension to 2^32 - 1 threads (gridDim * blockDim), so the launch failed with "invalid configuration argument" past about 4.2M outputs; mxfp4 quantize of a 4096x4096 matrix (an argmin over 16.7M groups) hits it.

Axes of at most 64 elements now use a 64-thread block (whole wavefronts on wave32 and wave64), and the grid spills into y so each dimension stays under the limit. The kernel already indexes blockIdx.x + blockIdx.y * gridDim.x with a bounds check. GPU mxfp4 quantize is then bit-identical to the CPU at 4096x4096.
---
 mlx/backend/rocm/arg_reduce.hip | 44 ++++++++++++++++++++++++---------
 1 file changed, 32 insertions(+), 12 deletions(-)

diff --git a/mlx/backend/rocm/arg_reduce.hip b/mlx/backend/rocm/arg_reduce.hip
index 069d89ae..22d012e4 100644
--- a/mlx/backend/rocm/arg_reduce.hip
+++ b/mlx/backend/rocm/arg_reduce.hip
@@ -1,5 +1,7 @@
 // Copyright © 2025 Apple Inc.
 
+#include <algorithm>
+#include <cstdint>
 #include "mlx/backend/common/utils.h"
 #include "mlx/backend/rocm/device.h"
 #include "mlx/backend/rocm/device/config.h"
@@ -287,18 +289,36 @@ void ArgReduce::eval_gpu(const std::vector<array>& inputs, array& out) {
   if (blocks_per_row > 64) blocks_per_row = 64;
 
   if (blocks_per_row <= 1) {
-    constexpr int BLOCK_DIM = 1024;
-    dim3 num_blocks = get_2d_grid_dims(out.shape(), out.strides());
-    dispatch_op([&](auto tt, auto opp) {
-      using T = decltype(tt);
-      using Op = decltype(opp);
-      encoder.add_kernel_node(
-          &rocm::arg_reduce_general<T, Op, BLOCK_DIM, 4>,
-          num_blocks, dim3(BLOCK_DIM), 0,
-          gpu_ptr<T>(in), gpu_ptr<uint32_t>(out), out_size,
-          shape_param, in_strides_param, out_strides_param,
-          ndim, axis_stride, axis_size);
-    });
+    // One block per output element. AMD caps every grid
+    // dimension at 2^32 - 1 threads (gridDim * blockDim), so 1024-thread
+    // blocks over a 1-D grid failed to launch past about 4.2M outputs (the
+    // mxfp4 quantize argmin over 16.7M elements hit it). Short axes use a
+    // 64-thread block (whole wavefronts on both wave32 and wave64), and the
+    // grid spills into y so each dimension stays under the cap. The kernel
+    // already indexes blockIdx.x + blockIdx.y * gridDim.x with a bounds check.
+    auto launch_general = [&](auto block_tag) {
+      constexpr int BLOCK_DIM = decltype(block_tag)::value;
+      constexpr size_t kMaxBlocksX = static_cast<size_t>(UINT32_MAX) / BLOCK_DIM;
+      size_t grid_x = std::min(out_size, kMaxBlocksX);
+      size_t grid_y = (out_size + grid_x - 1) / grid_x;
+      dim3 num_blocks(
+          static_cast<uint32_t>(grid_x), static_cast<uint32_t>(grid_y), 1);
+      dispatch_op([&](auto tt, auto opp) {
+        using T = decltype(tt);
+        using Op = decltype(opp);
+        encoder.add_kernel_node(
+            &rocm::arg_reduce_general<T, Op, BLOCK_DIM, 4>,
+            num_blocks, dim3(BLOCK_DIM), 0,
+            gpu_ptr<T>(in), gpu_ptr<uint32_t>(out), out_size,
+            shape_param, in_strides_param, out_strides_param,
+            ndim, axis_stride, axis_size);
+      });
+    };
+    if (axis_size <= 64) {
+      launch_general(std::integral_constant<int, 64>{});
+    } else {
+      launch_general(std::integral_constant<int, 1024>{});
+    }
     return;
   }
 
