+            .transitions
+            .iter()
+            .map(|(&token, &next)| (token, next))
+            .collect();
+        #[cfg(test)]
+        {
+            build_steps += transitions.len();
+        }
+        for (token, next) in transitions {
+            let mut fallback = nodes[state].failure;
+            let failure = loop {
+                #[cfg(test)]
+                {
