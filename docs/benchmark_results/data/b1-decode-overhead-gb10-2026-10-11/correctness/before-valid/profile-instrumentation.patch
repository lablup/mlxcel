+
+//! Temporary host-clock attribution for issue #2227's pre-change profile.
+//!
+//! This module is removed after the required baseline profile. It is gated by
+//! `MLXCEL_B1_DECODE_PROFILE=1`, so the same release binary can run the CLI arm
+//! without timer overhead and the server arm with per-stage attribution.
+
+use std::cell::Cell;
+use std::fmt::Write as _;
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+const PROFILE_ENV: &str = "MLXCEL_B1_DECODE_PROFILE";
+
+#[derive(Debug, Clone, Copy)]
+pub(super) enum Stage {
+    Metrics,
+    RowLookup,
+    RowBuild,
+    EngineStep,
+    FinishState,
+    ApplyOutcomes,
+    LookaheadSubmit,
+    LookaheadCollect,
+    FusedFinishRows,
+    FinalizeCompleted,
+}
+
+impl Stage {
+    const ALL: [Self; 10] = [
+        Self::Metrics,
+        Self::RowLookup,
+        Self::RowBuild,
+        Self::EngineStep,
+        Self::FinishState,
+        Self::ApplyOutcomes,
+        Self::LookaheadSubmit,
+        Self::LookaheadCollect,
+        Self::FusedFinishRows,
+        Self::FinalizeCompleted,
+    ];
+
+    const fn index(self) -> usize {
+        self as usize
+    }
+
+    const fn name(self) -> &'static str {
+        match self {
+            Self::Metrics => "metrics",
+            Self::RowLookup => "row_lookup",
+            Self::RowBuild => "row_build",
+            Self::EngineStep => "engine_step",
+            Self::FinishState => "finish_state",
+            Self::ApplyOutcomes => "apply_outcomes",
+            Self::LookaheadSubmit => "lookahead_submit",
+            Self::LookaheadCollect => "lookahead_collect",
+            Self::FusedFinishRows => "fused_finish_rows",
+            Self::FinalizeCompleted => "finalize_completed",
+        }
+    }
+}
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var(PROFILE_ENV).is_ok_and(|value| value.trim() == "1"))
+}
+
+pub(crate) fn started() -> Option<Instant> {
+    enabled().then(Instant::now)
+}
+
+fn duration_ns(duration: Duration) -> u64 {
+    duration.as_nanos().min(u128::from(u64::MAX)) as u64
+}
+
+thread_local! {
+    static EVENT_SEND_NS: Cell<u64> = const { Cell::new(0) };
+    static EVENT_SEND_CALLS: Cell<u64> = const { Cell::new(0) };
+}
+
+pub(crate) fn record_event_send(started: Option<Instant>) {
+    let Some(started) = started else {
+        return;
+    };
+    let elapsed = duration_ns(started.elapsed());
+    EVENT_SEND_NS.with(|total| total.set(total.get().saturating_add(elapsed)));
+    EVENT_SEND_CALLS.with(|calls| calls.set(calls.get().saturating_add(1)));
+}
+
+fn reset_event_send() {
+    EVENT_SEND_NS.with(|total| total.set(0));
+    EVENT_SEND_CALLS.with(|calls| calls.set(0));
+}
+
+fn event_send_snapshot() -> (u64, u64) {
+    let total = EVENT_SEND_NS.with(Cell::get);
+    let calls = EVENT_SEND_CALLS.with(Cell::get);
+    (total, calls)
+}
+
+pub(super) struct B1DecodeProfile {
+    enabled: bool,
+    run: Cell<u64>,
+    ticks: Cell<u64>,
+    tick_ns: Cell<u64>,
+    stage_ns: [Cell<u64>; Stage::ALL.len()],
+    stage_calls: [Cell<u64>; Stage::ALL.len()],
+}
+
+impl B1DecodeProfile {
+    pub(super) fn new() -> Self {
+        Self {
+            enabled: enabled(),
+            run: Cell::new(0),
+            ticks: Cell::new(0),
+            tick_ns: Cell::new(0),
+            stage_ns: std::array::from_fn(|_| Cell::new(0)),
+            stage_calls: std::array::from_fn(|_| Cell::new(0)),
+        }
+    }
+
+    pub(super) fn start(&self) -> Option<Instant> {
+        self.enabled.then(Instant::now)
+    }
+
+    pub(super) fn begin_decode_tick(&self) {
+        if !self.enabled || self.ticks.get() != 0 {
+            return;
+        }
+        self.clear_measurement();
+    }
+
+    pub(super) fn record(&self, stage: Stage, started: Option<Instant>) {
+        let Some(started) = started else {
+            return;
+        };
+        let index = stage.index();
+        self.stage_ns[index].set(
+            self.stage_ns[index]
+                .get()
+                .saturating_add(duration_ns(started.elapsed())),
+        );
+        self.stage_calls[index].set(self.stage_calls[index].get().saturating_add(1));
+    }
+
+    pub(super) fn record_tick(&self, started: Option<Instant>) {
+        let Some(started) = started else {
+            return;
+        };
+        self.tick_ns
+            .set(self.tick_ns.get().saturating_add(duration_ns(started.elapsed())));
+        self.ticks.set(self.ticks.get().saturating_add(1));
+    }
+
+    pub(super) fn emit_and_reset(&self) {
+        if !self.enabled || self.ticks.get() == 0 {
+            return;
+        }
+        let run = self.run.get().saturating_add(1);
+        self.run.set(run);
+        let ticks = self.ticks.get();
+        let tick_ns = self.tick_ns.get();
+        let mut line = format!(
+            "[b1-profile] {{\"run\":{run},\"ticks\":{ticks},\"tick_total_ns\":{tick_ns},\"tick_avg_us\":{:.3},\"stages\":{{",
+            tick_ns as f64 / ticks as f64 / 1_000.0
+        );
+        for (position, stage) in Stage::ALL.into_iter().enumerate() {
+            if position > 0 {
+                line.push(',');
+            }
+            let index = stage.index();
+            let total = self.stage_ns[index].get();
+            let calls = self.stage_calls[index].get();
+            let tick_pct = if tick_ns == 0 {
+                0.0
+            } else {
+                total as f64 * 100.0 / tick_ns as f64
+            };
+            let _ = write!(
+                line,
+                "\"{}\":{{\"calls\":{},\"total_ns\":{},\"tick_pct\":{:.4}}}",
+                stage.name(),
+                calls,
+                total,
+                tick_pct
+            );
+        }
+        let (event_ns, event_calls) = event_send_snapshot();
+        let event_pct = if tick_ns == 0 {
+            0.0
+        } else {
+            event_ns as f64 * 100.0 / tick_ns as f64
+        };
+        let _ = write!(
+            line,
+            "}},\"event_send\":{{\"calls\":{event_calls},\"total_ns\":{event_ns},\"tick_pct\":{event_pct:.4}}}}}"
+        );
+        eprintln!("{line}");
+        self.clear_measurement();
+    }
+
+    fn clear_measurement(&self) {
+        self.ticks.set(0);
+        self.tick_ns.set(0);
+        for value in &self.stage_ns {
+            value.set(0);
+        }
+        for value in &self.stage_calls {
+            value.set(0);
+        }
+        reset_event_send();
+    }
+}
