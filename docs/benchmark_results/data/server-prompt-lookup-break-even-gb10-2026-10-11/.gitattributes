# Preserve the concurrency client's trailing blank line byte-for-byte.
c-*-r*.txt -whitespace

# Preserve diagnostic patches and captured test output byte-for-byte.
trajectory-diagnostic/*.patch -whitespace
trajectory-diagnostic-after/*.patch -whitespace
trajectory-diagnostic-after/*-tests.log -whitespace

chat-trajectory-diagnostic/*.patch -whitespace
selective-trajectory-diagnostic/*.patch -whitespace
selective-trajectory-diagnostic/*-tests.log -whitespace
