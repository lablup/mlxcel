  "launch": {
    "index_space": "1d, one block per row",
    "grid_dim_rule": "rows",
    "block_dim_rule": "fused_norm_threads(dim)",
    "block_dim_definition": "clamp(ceil_div(ceil_div(dim, 4), 32) * 32, 32, 1024); rows wider than 4096 loop",
    "shared_mem_bytes": 0,
    "static_shared_bytes_per_block": 132,
    "buffer_layout": "x, residual, normed, new_residual are row-major [rows, dim] with exactly rows*dim elements; weight has exactly dim elements",
    "semantics": "new_residual = round_act(x + residual); normed = round_act(gain * round_act(new_residual * rsqrt(mean(new_residual^2) + eps))) with gain = weight when weight_bias == 0, else round_w(weight_bias + weight); f32 accumulation, f32 FMA on the squares, two-stage warp butterfly reduction in the reference kernel's order",
    "out_of_range_threads": "lanes past dim skip the element; the grid is exact, so no block returns before a barrier",
    "rejected_on_host": "rows == 0, dim == 0, x/residual length != rows*dim, weight length != dim, rows*dim > 2^32-1",
