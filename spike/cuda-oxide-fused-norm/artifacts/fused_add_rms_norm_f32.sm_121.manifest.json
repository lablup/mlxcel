  "launch": {
    "index_space": "1d, one block per row",
    "grid_dim_rule": "rows",
    "block_dim_rule": "fused_norm_cuda_block(dim, n_reads)",
    "block_dim_definition": "with nvec = ceil_div(dim, n_reads): 1024 if dim > n_reads * 1024 (the row loops), else 64 if dim <= n_reads * 64, else 128 if nvec % 128 == 0, else 64 if nvec % 64 == 0 and nvec <= 512, else 128; the block MLX's CUDA rms_norm launches for the compute dtype",
    "compute_dtype": "f32",
    "n_reads": 4,
    "shared_mem_bytes": 0,
    "static_shared_bytes_per_block": 132,
    "buffer_layout": "x, residual, normed, new_residual are row-major [rows, dim] with exactly rows*dim elements; weight has exactly dim elements",
    "semantics": "new_residual = round_act(x + residual); normed = round_act(gain * round_compute(new_residual * rsqrt(mean(new_residual^2) + eps))) with compute = promote(act, weight) under mlxcel's table (bf16 with f32 is bf16, f16 with f32 is f32) and gain = round_compute(weight) when weight_bias == 0, else round_compute(round_w(weight_bias + weight)); f32 accumulation, f32 FMA on the squares; lane t sums vectors t, t + block, ... of n_reads elements in ascending order, then the two-stage warp butterfly reduction, which is the order of MLX's CUDA rms_norm",
    "out_of_range_threads": "lanes past dim skip the element; the grid is exact, so no block returns before a barrier",
    "rejected_on_host": "rows == 0, dim == 0, x/residual length != rows*dim, weight length != dim, rows*dim > 2^32-1",
    "case_count": 26,
    "elements_total": 436278
  }
