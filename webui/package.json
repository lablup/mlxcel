{
  "name": "@lablup/mlxcel-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "unit": "node --test scripts/activity-performance-diagnostics.spec.mjs scripts/activity-stream.spec.mjs scripts/check-theme-selectors.spec.mjs && vitest run",
    "check:theme-selectors": "node scripts/check-theme-selectors.mjs",
    "check:agents": "ui-common agents --check --write AGENTS.md",
    "build:themes": "ui-common astryx theme build src/design-system/themes/mlxcel.theme.ts -o src/design-system/themes/built/mlxcel.css && ui-common astryx theme build src/design-system/themes/glass.theme.ts -o src/design-system/themes/built/mlxcel-glass.css",
    "check:themes": "ui-common astryx theme build -c src/design-system/themes/mlxcel.theme.ts -o src/design-system/themes/built/mlxcel.css && ui-common astryx theme build -c src/design-system/themes/glass.theme.ts -o src/design-system/themes/built/mlxcel-glass.css",
    "ui-common": "ui-common",
    "browser": "playwright test --project=chromium",
    "browser:all": "playwright test --config playwright.engines.config.ts",
    "browser:rust-router": "playwright test --config playwright.rust-router.config.ts",
    "verify-generated": "python3 ../scripts/webui/build_bundle.py --verify"
  },
  "dependencies": {
    "@astryxdesign/lab": "0.7.0-canary.97a0d31",
    "@lablup/ui-common": "0.2.0-alpha.19",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lablup/ui-common-cli": "0.2.0-alpha.19",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.5.1",
    "pnpm": "12.16.1"
  }
}
