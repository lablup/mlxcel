{
  "name": "@lablup/mlxcel-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
